+package org.apache.webbeans.test.interceptors.transitivebinding;
+
+import java.util.concurrent.atomic.AtomicInteger;
+
+import jakarta.annotation.PostConstruct;
+import jakarta.annotation.Priority;
+import jakarta.interceptor.AroundConstruct;
+import jakarta.interceptor.AroundInvoke;
+import jakarta.interceptor.Interceptor;
+import jakarta.interceptor.InvocationContext;
+
+@Interceptor
+@CountingBinding
+@Priority(Interceptor.Priority.APPLICATION)
+public class CountingInterceptor
+{
+    public static final AtomicInteger count = new AtomicInteger();
+    public static final AtomicInteger postConstructCount = new AtomicInteger();
+    public static final AtomicInteger aroundConstructCount = new AtomicInteger();
+
+    public static void reset()
+    {
+        count.set(0);
+        postConstructCount.set(0);
+        aroundConstructCount.set(0);
+    }
+
+    @AroundInvoke
+    public Object intercept(InvocationContext context) throws Exception
+    {
+        count.incrementAndGet();
+        return context.proceed();
+    }
+
+    @AroundConstruct
+    public void onAroundConstruct(InvocationContext context)
+    {
+        aroundConstructCount.incrementAndGet();
+        try
+        {
+            context.proceed();
+        }
+        catch (Exception e)
+        {
+            throw new RuntimeException(e);
+        }
+    }
+
+    @PostConstruct
+    public void onPostConstruct(InvocationContext context)
+    {
+        postConstructCount.incrementAndGet();
+        try
+        {
+            context.proceed();
+        }
+        catch (Exception e)
+        {
+            throw new RuntimeException(e);
+        }
+    }
+}
