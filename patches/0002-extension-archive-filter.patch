+    private URL explodeModule(URL module) throws Exception
+    {
+        final java.nio.file.Path directory = temp.newFolder("extension directory").toPath();
+        try (java.util.jar.JarFile archive = new java.util.jar.JarFile(new File(module.toURI())))
+        {
+            for (JarEntry entry : java.util.Collections.list(archive.entries()))
+            {
+                final java.nio.file.Path destination = directory.resolve(entry.getName());
+                java.nio.file.Files.createDirectories(destination.getParent());
+                try (java.io.InputStream input = archive.getInputStream(entry))
+                {
+                    java.nio.file.Files.copy(input, destination);
+                }
+            }
+        }
+        return directory.toUri().toURL();
